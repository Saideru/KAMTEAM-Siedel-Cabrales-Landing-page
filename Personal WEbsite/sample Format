<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Marcus Vane — Founder · Investor · Operator</title>
<meta name="description" content="Marcus Vane — Founder, Investor, Operator. Conviction before consensus.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Onest:wght@400;500;600&display=swap" rel="stylesheet">

<script>
  /* Adaptive grid: damped scale-up above 1920px (vw media queries drive below) */
  (function(){
    var FONT_BASE = 16, BASE_W = 1920, COEF = 0.6666;
    function applyAdaptiveGrid(){
      var w = window.innerWidth;
      var reduction = ((BASE_W - w) / BASE_W) * 100 * COEF;
      var size = FONT_BASE - (FONT_BASE * reduction) / 100;
      if (size > FONT_BASE) document.documentElement.style.fontSize = size + "px";
      else document.documentElement.style.removeProperty("font-size");
    }
    applyAdaptiveGrid();
    window.addEventListener("resize", applyAdaptiveGrid);
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("rm");
    } else {
      document.documentElement.classList.add("is-loading");
    }
    if ("scrollRestoration" in history) history.scrollRestoration = "manual";
  })();
</script>

<script type="importmap">
{ "imports": { "lenis": "https://cdn.jsdelivr.net/npm/lenis@1.3.19/dist/lenis.mjs" } }
</script>

<style>
/* ================= Reset ================= */
*{margin:0;padding:0;box-sizing:border-box}
img,video{display:block;max-width:100%}
ul,ol{list-style:none}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;-webkit-appearance:none;appearance:none}

/* ================= Tokens ================= */
:root{
  --background:#08080a; --foreground:#f3f1ea; --surface:#111114; --surface-2:#17171b;
  --muted:#807f78; --line:rgba(243,241,234,0.1); --line-strong:rgba(243,241,234,0.22);
  --accent:#ff3b1d; --accent-2:#ff6a3d;
  --gutter:2.5rem; --section:9rem;
  --font-display:"Anton", sans-serif;
  --font-sans:"Onest", sans-serif;
  --expo:cubic-bezier(0.16,1,0.3,1);
  --quart:cubic-bezier(0.165,0.84,0.44,1);
  --wipe:cubic-bezier(0.22,1,0.36,1);
}

/* ================= Adaptive rem grid ================= */
html{font-size:16px;background:#08080a}
@media (max-width:1920px){html{font-size:0.833333vw}}
@media (max-width:1440px){html{font-size:1.111111vw}}
@media (max-width:1024px){html{font-size:1.5625vw}}
@media (max-width:640px){
  html{font-size:4.444444vw}
  :root{--gutter:16px}
}

/* Lenis recommended */
html.lenis, html.lenis body{height:auto}
.lenis.lenis-smooth{scroll-behavior:auto !important}
.lenis.lenis-smooth [data-lenis-prevent]{overscroll-behavior:contain}
.lenis.lenis-stopped{overflow:clip}
html.is-loading{overflow:hidden}

body{
  background:#08080a;color:#f3f1ea;font-family:var(--font-sans);
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
  text-rendering:optimizeLegibility;overflow-x:hidden;
  font-size:1.0625rem;line-height:1.6;
}
::selection{background:#ff3b1d;color:#08080a}

/* ================= Type scale ================= */
.t-hero{font-size:28rem;line-height:0.78}
.t-mega{font-size:13rem;line-height:0.86}
.t-display{font-size:7.5rem;line-height:0.9}
.t-h1{font-size:5rem;line-height:0.95}
.t-h2{font-size:3.25rem;line-height:1}
.t-h3{font-size:1.75rem;line-height:1.15}
.t-lead{font-size:1.375rem;line-height:1.45}
.t-body{font-size:1.0625rem;line-height:1.6}
.t-eyebrow{font-size:0.8125rem;line-height:1.2}

.display{font-family:var(--font-display);font-weight:400;text-transform:uppercase;letter-spacing:-0.01em}
.muted{color:var(--muted)}
.accent{color:var(--accent)}

.eyebrow{
  display:flex;align-items:center;gap:0.75rem;
  font-size:0.8125rem;line-height:1.2;font-weight:500;text-transform:uppercase;
  letter-spacing:0.22em;color:var(--muted);
}
.eyebrow::before{content:"";width:0.5rem;height:0.5rem;border-radius:9999px;background:var(--accent);flex-shrink:0}

main{position:relative;width:100%;overflow-x:hidden}
.section{padding:var(--section) var(--gutter)}

/* ================= Motion primitives ================= */
.reveal{
  opacity:0;transform:translateY(var(--ry,40px));
  transition:opacity var(--dur,560ms) var(--ease,var(--expo)),transform var(--dur,560ms) var(--ease,var(--expo));
  transition-delay:var(--delay,0ms);
}
.reveal.in-view{opacity:1;transform:none}

.split .line{display:block;overflow:hidden;padding:0.1em 0;margin:-0.1em 0}
.split .line-inner{
  display:block;transform:translateY(110%);opacity:0;
  transition:transform var(--ldur,900ms) var(--expo),opacity var(--ldur,900ms) var(--expo);
}
.split.in-view .line-inner{transform:none;opacity:1}
.split:not(.is-split){visibility:hidden}
.split.is-done{visibility:visible}

/* ================= Preloader ================= */
.preloader{
  position:fixed;inset:0;z-index:100;display:flex;padding:var(--gutter);
  flex-direction:column;align-items:flex-start;justify-content:flex-end;gap:0.75rem;
  transition:transform 650ms var(--wipe);will-change:transform;
}
.preloader .pl-bg{position:absolute;inset:0;z-index:-10;background:var(--background)}
.pl-brand{font-family:var(--font-display);font-size:1.75rem;text-transform:uppercase;line-height:1;letter-spacing:-0.01em;color:var(--foreground)}
.pl-count{font-family:var(--font-display);font-size:7.5rem;line-height:1;font-variant-numeric:tabular-nums;color:var(--foreground)}
.pl-brand,.pl-count{transition:opacity 300ms ease-out}
.preloader.is-fading .pl-brand,.preloader.is-fading .pl-count{opacity:0}
.preloader.is-wiping{transform:translateY(-100%)}
.preloader.is-done{pointer-events:none;visibility:hidden}
@media (min-width:640px){
  .preloader{flex-direction:row;align-items:flex-end;justify-content:space-between;gap:1rem}
}

/* ================= Nav ================= */
.site-header{position:fixed;inset-inline:0;top:0;z-index:50;pointer-events:none}
.site-nav{pointer-events:auto;display:flex;align-items:center;justify-content:space-between;padding:1.5rem var(--gutter)}
.logo{display:flex;align-items:center;gap:0.75rem;position:relative;z-index:60}
.monogram{display:grid;place-items:center;width:2.5rem;height:2.5rem;border-radius:9999px;border:1px solid var(--line-strong);font-weight:600;letter-spacing:-0.01em;font-size:0.9375rem}
.logo-name{display:none;font-size:0.8125rem;line-height:1.2;font-weight:500;text-transform:uppercase;letter-spacing:0.22em;color:var(--muted)}
@media (min-width:640px){.logo-name{display:block}}
.nav-links{display:none;gap:2.5rem}
.nav-links a{position:relative;font-size:0.8125rem;line-height:1.2;font-weight:500;text-transform:uppercase;letter-spacing:0.18em;color:var(--muted);transition:color 340ms ease-out}
.nav-links a::after{content:"";position:absolute;bottom:-0.25rem;left:0;height:1px;width:0;background:var(--accent);transition:width 340ms var(--expo)}
.nav-links a:hover,.nav-links a:focus-visible{color:var(--foreground)}
.nav-links a:hover::after,.nav-links a:focus-visible::after{width:100%}
.burger{position:relative;z-index:60;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.375rem;width:2.5rem;height:2.5rem}
.burger span{display:block;height:0.125rem;width:1.5rem;background:var(--foreground);transition:transform 420ms var(--expo),opacity 300ms ease-out}
.burger.is-open span:nth-child(1){transform:translateY(0.5rem) rotate(45deg)}
.burger.is-open span:nth-child(2){opacity:0}
.burger.is-open span:nth-child(3){transform:translateY(-0.5rem) rotate(-45deg)}
@media (min-width:768px){.nav-links{display:flex}.burger{display:none}}

.mobile-menu{
  position:fixed;inset:0;z-index:50;background:var(--background);
  display:flex;flex-direction:column;justify-content:center;padding-inline:var(--gutter);
  opacity:0;visibility:hidden;pointer-events:none;
  transition:opacity 450ms ease-out,visibility 0s linear 450ms;
}
.mobile-menu.is-open{opacity:1;visibility:visible;pointer-events:auto;transition:opacity 450ms ease-out,visibility 0s}
.mobile-menu ul{display:flex;flex-direction:column;gap:1rem}
.mobile-menu a{
  display:block;font-family:var(--font-display);font-size:3.25rem;text-transform:uppercase;line-height:1;letter-spacing:-0.01em;
  transform:translateY(48px);opacity:0;transition:transform 420ms ease-out,opacity 420ms ease-out;
}
.mobile-menu.is-open a{transform:none;opacity:1}
.mobile-menu a:hover{color:var(--accent)}
@media (min-width:768px){.mobile-menu{display:none}}

/* ================= Hero ================= */
.hero{position:relative;display:flex;flex-direction:column;min-height:100svh;overflow:hidden}
.hero-top{position:relative;z-index:30;display:flex;flex-direction:column;gap:2rem;padding:7rem var(--gutter) 0}
.hero-roles{font-family:var(--font-display);font-weight:400;text-transform:uppercase;line-height:1.05;letter-spacing:-0.01em;color:var(--foreground);font-size:1.75rem}
.hero-roles .line{display:block;overflow:hidden;padding:0.06em 0;margin:-0.06em 0}
.hero-roles .line-inner{display:block;transform:translateY(110%);opacity:0;transition:transform 760ms var(--expo),opacity 760ms var(--expo)}
.hero.in-view .hero-roles .line-inner{transform:none;opacity:1}
.hero-desc{max-width:26rem;font-size:1.0625rem;line-height:1.6;color:var(--muted)}
@media (min-width:640px){
  .hero-top{flex-direction:row;align-items:flex-start;justify-content:space-between;padding-top:8rem}
  .hero-roles{font-size:3.25rem}
  .hero-desc{text-align:right}
}
.hero-portrait{position:absolute;z-index:20;pointer-events:none;bottom:0;left:50%;transform:translateX(-50%);height:86vh;width:80vw}
.hero-portrait .liquid{pointer-events:auto;width:100%;height:100%}
@media (min-width:640px){.hero-portrait{width:48vw}}
@media (min-width:1024px){.hero-portrait{width:36vw}}
.hero-fade{position:absolute;inset-inline:0;bottom:0;z-index:20;height:26vh;background:linear-gradient(to bottom,transparent,#08080a);pointer-events:none}
.hero-name{
  position:absolute;z-index:10;inset-inline:0;bottom:0;transform:translateY(6%);
  display:flex;flex-direction:column;align-items:center;
  font-family:var(--font-display);font-weight:400;text-transform:uppercase;line-height:0.78;letter-spacing:-0.01em;
  color:var(--accent);font-size:13rem;
}
.hero-name .nl{display:block;white-space:nowrap}
.hero-name .ch{display:inline-block;transform:translateY(100%);opacity:0;transition:transform 900ms var(--expo),opacity 900ms var(--expo)}
.hero.in-view .hero-name .ch{transform:none;opacity:1}
@media (min-width:640px){.hero-name{font-size:28rem}}
.scroll-cue{position:absolute;z-index:30;bottom:2rem;left:var(--gutter);display:flex;align-items:center;gap:0.75rem;font-size:0.8125rem;line-height:1.2;text-transform:uppercase;letter-spacing:0.22em;color:var(--muted)}
.scroll-cue::before{content:"";width:2.5rem;height:1px;background:var(--accent)}

/* ================= Marquee ================= */
.marquee{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:2rem 0}
.marquee-track{display:flex;width:max-content;flex-wrap:nowrap;animation:marquee 22s linear infinite;will-change:transform}
.marquee-item{display:flex;align-items:center;flex-shrink:0}
.marquee-word{font-family:var(--font-display);font-size:3.25rem;line-height:1;text-transform:uppercase;letter-spacing:-0.01em;white-space:nowrap}
.marquee-dot{margin-inline:2rem;width:0.625rem;height:0.625rem;border-radius:9999px;background:var(--accent);flex-shrink:0}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ================= Story ================= */
.story-grid{display:grid;grid-template-columns:1fr;gap:3rem}
.sec-h{margin-top:1.5rem;font-family:var(--font-display);font-weight:400;text-transform:uppercase;letter-spacing:-0.01em}
.story-h{max-width:16ch;font-size:3.25rem;line-height:0.95}
.story-body{margin-top:2rem;max-width:46ch;font-size:1.375rem;line-height:1.45;color:var(--muted)}
.principle{display:grid;grid-template-columns:auto 1fr;column-gap:1.5rem;border-top:1px solid var(--line);padding:2rem 0}
.principle:last-child{border-bottom:1px solid var(--line)}
.principle-num{font-size:1.75rem;line-height:1.15;font-weight:600;font-variant-numeric:tabular-nums;color:var(--accent)}
.principle h3{font-size:1.75rem;line-height:1.15;font-weight:600;letter-spacing:-0.01em}
.principle p{margin-top:0.75rem;max-width:44ch;font-size:1.0625rem;line-height:1.6;color:var(--muted)}
@media (min-width:640px){.story-h{font-size:5rem}}
@media (min-width:1024px){
  .story-grid{grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--gutter)}
  .story-left{grid-column:span 6}
  .story-right{grid-column:span 6;padding-top:0.5rem}
}

/* ================= Ventures ================= */
.sec-head{display:flex;flex-direction:column;gap:1.5rem}
@media (min-width:640px){.sec-head{flex-direction:row;align-items:flex-end;justify-content:space-between}}
.ventures-h{max-width:14ch;font-size:3.25rem;line-height:0.95}
@media (min-width:640px){.ventures-h{font-size:5rem}}
.sec-label{font-size:0.8125rem;line-height:1.2;text-transform:uppercase;letter-spacing:0.22em;color:var(--muted)}
.ventures-list{margin-top:4rem;display:grid;grid-template-columns:1fr;column-gap:var(--gutter);row-gap:4rem}
@media (min-width:768px){
  .ventures-list{grid-template-columns:repeat(2,minmax(0,1fr))}
  .ventures-list > li:nth-child(2n){margin-top:6rem}
}
.venture .liquid{aspect-ratio:16/11;width:100%;border-radius:0.125rem}
.venture-row{margin-top:1.5rem;border-top:1px solid var(--line);padding-top:1.25rem;display:flex;align-items:flex-start;justify-content:space-between;gap:1.5rem}
.venture-row h3{font-size:1.75rem;line-height:1.15;font-weight:600;letter-spacing:-0.01em;color:var(--foreground);transition:color 380ms ease-out}
.venture.is-hover .venture-row h3{color:var(--accent)}
.venture-row p{margin-top:0.5rem;max-width:42ch;font-size:1.0625rem;line-height:1.6;color:var(--muted)}
.venture-meta{flex-shrink:0;text-align:right}
.venture-year{font-size:0.8125rem;line-height:1.2;text-transform:uppercase;letter-spacing:0.18em;color:var(--muted)}
.venture-outcome{margin-top:0.5rem;font-size:0.8125rem;line-height:1.2;font-weight:500;text-transform:uppercase;letter-spacing:0.18em;color:var(--accent)}
.venture-cat{margin-top:0.75rem;font-size:0.8125rem;line-height:1.2;text-transform:uppercase;letter-spacing:0.22em;color:var(--muted)}

/* ================= Impact ================= */
.plain-h{font-size:3.25rem;line-height:1}
.stats{margin-top:4rem;display:grid;grid-template-columns:1fr;border-top:1px solid var(--line)}
.stat{display:flex;flex-direction:column;gap:1rem;border-bottom:1px solid var(--line);padding:2.5rem 0}
.stat dd{font-family:var(--font-display);font-size:7.5rem;line-height:1;letter-spacing:-0.01em;color:var(--foreground);transition:color 340ms ease-out}
.stat:hover dd{color:var(--accent)}
.stat dt{max-width:20ch;font-size:1.0625rem;line-height:1.6;text-transform:uppercase;letter-spacing:0.14em;color:var(--muted)}
@media (min-width:640px) and (max-width:1023.98px){
  .stats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .stat:nth-child(2n){border-left:1px solid var(--line);padding-left:2rem}
}
@media (min-width:1024px){
  .stats{grid-template-columns:repeat(4,minmax(0,1fr))}
  .stat{padding:3rem 0}
  .stat:not(:nth-child(4n+1)){border-left:1px solid var(--line);padding-left:2rem}
}

/* ================= Voices ================= */
.voices-grid{margin-top:4rem;display:grid;grid-template-columns:1fr;gap:3rem}
@media (min-width:1024px){
  .voices-grid{grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--gutter)}
  .voices-list{grid-column:span 5}
  .voices-panel{grid-column:span 7}
}
.voice-btn{width:100%;display:flex;align-items:baseline;gap:1.25rem;border-top:1px solid var(--line);padding:1.75rem 0;text-align:left}
.voices-list li:last-child .voice-btn{border-bottom:1px solid var(--line)}
.voice-idx{font-size:0.8125rem;line-height:1.2;font-variant-numeric:tabular-nums;letter-spacing:0.18em;color:var(--muted);transition:color 340ms ease-out}
.voice-name{display:block;font-size:1.75rem;line-height:1.15;font-weight:600;letter-spacing:-0.01em;color:var(--muted);transition:color 340ms ease-out}
.voice-role{display:block;margin-top:0.25rem;font-size:0.8125rem;line-height:1.2;text-transform:uppercase;letter-spacing:0.18em;color:var(--muted)}
.voice-rule{margin-left:auto;align-self:center;height:1px;width:0;background:var(--accent);flex-shrink:0;transition:width 420ms var(--expo)}
.voice-btn.is-active .voice-idx{color:var(--accent)}
.voice-btn.is-active .voice-name{color:var(--foreground)}
.voice-btn.is-active .voice-rule{width:2.5rem}
.voice-btn:focus-visible{outline:1px solid var(--accent);outline-offset:4px}

.voices-panel{display:grid;grid-template-columns:1fr;gap:2rem;align-items:flex-start}
.voice-quote{order:2}
.voice-figure-wrap{order:1}
@media (min-width:640px){
  .voices-panel{grid-template-columns:1fr auto}
  .voice-quote{order:1}
  .voice-figure-wrap{order:2;width:16rem}
}
.voice-quote p{max-width:30ch;font-size:1.75rem;font-weight:500;line-height:1.3;letter-spacing:-0.01em;color:var(--foreground)}
.voice-quote .qw{display:inline-block;transform:translateY(18px);opacity:0}
.voice-quote.play .qw{transform:none;opacity:1;transition:transform 520ms var(--quart),opacity 520ms var(--quart)}
.voice-quote footer{margin-top:2rem;font-size:0.8125rem;line-height:1.2;text-transform:uppercase;letter-spacing:0.18em;color:var(--muted)}
.voice-figure-wrap .liquid{aspect-ratio:4/5;width:100%;border-radius:0.125rem}
.voice-figure-wrap{opacity:0;transform:scale(1.06);transition:opacity 640ms var(--expo),transform 640ms var(--expo)}
.voice-figure-wrap.in-view{opacity:1;transform:none}

/* ================= Contact / Footer ================= */
.contact{padding-top:var(--section);padding-inline:var(--gutter)}
.contact-h{max-width:18ch;font-size:5rem;line-height:0.95}
@media (min-width:640px){.contact-h{font-size:7.5rem}}
.contact-body{margin-top:2rem;max-width:44ch;font-size:1.375rem;line-height:1.45;color:var(--muted)}
.email-wrap{margin-top:3rem}
.email{
  display:inline-flex;align-items:baseline;gap:0.75rem;font-size:1.75rem;line-height:1.15;font-weight:600;letter-spacing:-0.01em;word-break:break-all;
  color:var(--foreground);transition:transform 340ms ease-out,color 340ms ease-out;
}
.email:hover,.email:focus-visible{transform:translateX(14px);color:var(--accent)}
.email .arrow{color:var(--accent)}
@media (min-width:640px){.email{gap:1rem;font-size:5rem;line-height:0.95}}
.footer-bar{margin-top:var(--section);border-top:1px solid var(--line);padding:3rem 0;display:grid;grid-template-columns:1fr;gap:2.5rem}
.sig{font-family:var(--font-display);font-size:3.25rem;text-transform:uppercase;line-height:1;letter-spacing:-0.01em}
.sig-sub{margin-top:1rem;font-size:0.8125rem;line-height:1.2;text-transform:uppercase;letter-spacing:0.22em;color:var(--muted)}
.social ul{display:flex;flex-direction:column;gap:0.75rem}
.social a{display:inline-flex;align-items:center;font-size:1.0625rem;line-height:1.6;color:var(--muted);transition:color 340ms ease-out}
.social a::before{content:"";height:1px;width:0;margin-right:0;background:var(--accent);transition:width 340ms var(--expo),margin-right 340ms var(--expo)}
.social a:hover,.social a:focus-visible{color:var(--foreground)}
.social a:hover::before,.social a:focus-visible::before{width:1.5rem;margin-right:0.75rem}
.copyright{font-size:0.8125rem;line-height:1.2;text-transform:uppercase;letter-spacing:0.18em;color:var(--muted)}
@media (min-width:1024px){
  .footer-bar{grid-template-columns:repeat(12,minmax(0,1fr))}
  .fb-left{grid-column:span 6}
  .fb-mid{grid-column:span 3}
  .fb-right{grid-column:span 3;text-align:right}
}

/* ================= LiquidImage ================= */
.liquid{position:relative;overflow:hidden;margin:0;background:radial-gradient(130% 130% at 30% 15%,var(--surface-2),var(--background))}
.liquid.is-bare{background:transparent}
.liq-svg{position:absolute;width:0;height:0;overflow:hidden}
.liq-media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
.liquid.is-bare .liq-media{object-position:center bottom}
.liq-veil,.liq-glow,.liq-vignette{position:absolute;inset:0;pointer-events:none}
.liq-veil{background:var(--background);mix-blend-mode:color;opacity:0.88;transition:opacity 380ms ease-out}
.liq-glow{background:linear-gradient(120deg,transparent 30%,color-mix(in srgb,var(--accent) 35%,transparent) 50%,transparent 70%);opacity:0;transition:opacity 340ms ease-out}
.liq-vignette{background:radial-gradient(120% 120% at 50% 120%,color-mix(in srgb,#08080a 70%,transparent),transparent 60%)}
.liquid.is-hover .liq-veil{opacity:0}
.liquid.is-hover .liq-glow{opacity:1}
.liq-label{position:absolute;inset:0;display:none;place-items:center;font-family:var(--font-display);font-size:2rem;text-transform:uppercase;letter-spacing:-0.01em;color:var(--muted)}
.liquid.is-missing .liq-label{display:grid}
.liquid.is-missing .liq-media{display:none}

/* ================= Reduced motion ================= */
@media (prefers-reduced-motion: reduce){
  .preloader{display:none !important}
  .marquee-track{animation:none !important}
  .reveal,.split .line-inner,.hero-roles .line-inner,.hero-name .ch,.voice-quote .qw,.voice-figure-wrap,.mobile-menu a{
    opacity:1 !important;transform:none !important;transition:none !important;
  }
  .split:not(.is-split){visibility:visible}
}
.rm .preloader{display:none !important}
.rm .marquee-track{animation:none !important}
.rm .reveal,.rm .split .line-inner,.rm .hero-roles .line-inner,.rm .hero-name .ch,.rm .voice-quote .qw,.rm .voice-figure-wrap{
  opacity:1 !important;transform:none !important;transition:none !important;
}
.rm .split:not(.is-split){visibility:visible}
</style>

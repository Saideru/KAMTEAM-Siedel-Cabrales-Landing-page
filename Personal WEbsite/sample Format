const ASSETS = "https://api.getlayers.ai/storage/v1/object/public/public/assets/marcus-vane-6799bd1fb6";
const REDUCED = document.documentElement.classList.contains("rm");
const CAN_HOVER = () => window.matchMedia("(hover: hover) and (pointer: fine) and (min-width: 769px)").matches;


let active = 0;

function renderQuote(i){
  const v = VOICES[i];
  const words = ("“" + v.quote + "”").split(" ");
  textEl.textContent = "";
  words.forEach((w, k) => {
    const s = document.createElement("span");
    s.className = "qw";
    s.textContent = w;
    s.style.transitionDelay = (k * 22) + "ms";
    textEl.appendChild(s);
    if (k < words.length - 1) textEl.appendChild(document.createTextNode(" "));
  });
  citeEl.textContent = `${v.name} — ${v.role}`;
}
function playQuote(){
  quoteEl.classList.remove("play");
  void quoteEl.offsetWidth; // reflow to restart
  quoteEl.classList.add("play");
}
function setActive(i){
  if (i === active) return;
  active = i;
  document.querySelectorAll(".voice-btn").forEach(b => {
    const on = Number(b.dataset.i) === i;
    b.classList.toggle("is-active", on);
    b.setAttribute("aria-pressed", on);
  });
  renderQuote(i);
  playQuote();
  voiceImg.setSrc(VOICES[i].img, VOICES[i].name);
}
renderQuote(0);
if (REDUCED) quoteEl.classList.add("play");
document.querySelectorAll(".voice-btn").forEach(b => {
  const i = Number(b.dataset.i);
  b.addEventListener("mouseenter", () => setActive(i));
  b.addEventListener("focus", () => setActive(i));
  b.addEventListener("click", () => setActive(i));
});

/* ================================================================
   Mobile menu
   ================================================================ */
const burger = document.getElementById("burger");
const menu = document.getElementById("mobileMenu");
menu.querySelectorAll("a").forEach((a, i) => { a.style.transitionDelay = (120 + i * 60) + "ms"; });
function openMenu(){
  burger.classList.add("is-open"); menu.classList.add("is-open");
  burger.setAttribute("aria-expanded", "true"); burger.setAttribute("aria-label", "Close menu");
  menu.setAttribute("aria-hidden", "false");
  if (lenis) lenis.stop();
}
function closeMenu(){
  if (!menu.classList.contains("is-open")) return;
  burger.classList.remove("is-open"); menu.classList.remove("is-open");
  burger.setAttribute("aria-expanded", "false"); burger.setAttribute("aria-label", "Open menu");
  menu.setAttribute("aria-hidden", "true");
  menu.querySelectorAll("a").forEach(a => { a.style.transitionDelay = "0ms"; });
  setTimeout(() => menu.querySelectorAll("a").forEach((a, i) => { a.style.transitionDelay = (120 + i * 60) + "ms"; }), 450);
  if (lenis && !preloading) lenis.start();
}
burger.addEventListener("click", () => menu.classList.contains("is-open") ? closeMenu() : openMenu());
addEventListener("keydown", e => { if (e.key === "Escape") closeMenu(); });

/* ================================================================
   Preloader + hero sequencing
   ================================================================ */
const pre = document.getElementById("preloader");
const num = document.getElementById("plNum");
const hero = document.getElementById("top");

function startHero(){
  hero.classList.add("in-view");
  hero.querySelectorAll(".reveal").forEach(el => el.classList.add("in-view"));
}

function finishPreload(){
  preloading = false;
  pre.classList.add("is-done");
  pre.setAttribute("aria-hidden", "true");
  document.documentElement.classList.remove("is-loading");
  if (lenis) lenis.start();
}

if (REDUCED){
  pre.classList.add("is-done");
  pre.setAttribute("aria-hidden", "true");
  startHero();
} else {
  // hero timeline starts now; all delays are baked in relative to this moment (REVEAL_DELAY = 2500ms)
  requestAnimationFrame(() => requestAnimationFrame(startHero));

  const COUNT_MS = 2000;
  const t0 = performance.now();
  function tick(t){
    const p = Math.min(1, (t - t0) / COUNT_MS);
    num.textContent = Math.round(p * 100);
    if (p < 1) return requestAnimationFrame(tick);
    pre.classList.add("is-fading");                // labels fade ~300ms
    setTimeout(() => {
      pre.classList.add("is-wiping");              // wipe up ~650ms
      pre.addEventListener("transitionend", function onEnd(e){
        if (e.target !== pre || e.propertyName !== "transform") return;
        pre.removeEventListener("transitionend", onEnd);
        finishPreload();
      });
      setTimeout(() => { if (preloading) finishPreload(); }, 900); // safety
    }, 200);
  }
  requestAnimationFrame(tick);
}
</script>

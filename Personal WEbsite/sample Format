    closeMenu();
    scrollToTarget(id === "#top" ? 0 : target);
  });
});

/* ================================================================
   Spring simulator (tension / friction, mass 1) — for liquid filter
   ================================================================ */
function createSpring(onUpdate, { tension, friction }){
  let x = 0, v = 0, target = 0, raf = null, last = 0;
  function step(t){
    const dt = Math.min(0.064, (t - last) / 1000); last = t;
    const sub = 8, h = dt / sub;
    for (let i = 0; i < sub; i++){
      const a = -tension * (x - target) - friction * v;
      v += a * h; x += v * h;
    }
    if (Math.abs(v) < 0.0005 && Math.abs(x - target) < 0.0005){ x = target; v = 0; onUpdate(x); raf = null; return; }
    onUpdate(x);
    raf = requestAnimationFrame(step);
  }
  return {
    set(t){ target = t; if (!raf){ last = performance.now(); raf = requestAnimationFrame(step); } }
  };
}

/* ================================================================
   LiquidImage
   ================================================================ */
let liqCount = 0;
function mountLiquid(fig, { src, alt, bare = false, maxScale = 28, video = null, label = alt, hoverTarget = null }){
  const id = "liquid-" + (++liqCount);
  fig.classList.add("liquid");
  if (bare) fig.classList.add("is-bare");
  fig.setAttribute("role", "img");
  fig.setAttribute("aria-label", alt);

  const media = video
    ? `<video class="liq-media" style="filter:url(#${id})" src="${video}" poster="${src}" autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>`
    : `<img class="liq-media" style="filter:url(#${id})" src="${src}" alt="" loading="lazy" decoding="async">`;
  const overlays = bare ? "" : `<span class="liq-veil"></span><span class="liq-glow"></span><span class="liq-vignette"></span>`;

  fig.innerHTML =
    `<svg class="liq-svg" aria-hidden="true" focusable="false"><defs>
       <filter id="${id}" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
         <feTurbulence type="fractalNoise" baseFrequency="0.009" numOctaves="2" result="noise"/>
         <feDisplacementMap in="SourceGraphic" in2="noise" scale="1" xChannelSelector="R" yChannelSelector="G"/>
       </filter></defs></svg>` +
    media + overlays + `<span class="liq-label">${label}</span>`;

  const turb = fig.querySelector("feTurbulence");
  const disp = fig.querySelector("feDisplacementMap");
  const m = fig.querySelector(".liq-media");
  m.addEventListener("error", () => { if (!video) fig.classList.add("is-missing"); });

  // Imperative attribute writes driven by a loose watery spring (140 / 13)
  const spring = createSpring(p => {
    disp.setAttribute("scale", (1 + p * (maxScale - 1)).toFixed(3));
    turb.setAttribute("baseFrequency", Math.max(0.001, 0.009 + p * 0.013).toFixed(5));
  }, { tension: 140, friction: 13 });

  const target = hoverTarget || fig;
  target.addEventListener("pointerenter", () => {
    if (!CAN_HOVER() || REDUCED) return;
    fig.classList.add("is-hover");
    if (hoverTarget) hoverTarget.classList.add("is-hover");
    spring.set(1);
  });
  target.addEventListener("pointerleave", () => {
    fig.classList.remove("is-hover");
    if (hoverTarget) hoverTarget.classList.remove("is-hover");
    spring.set(0);
  });

  return {
    setSrc(newSrc, newAlt){
      fig.classList.remove("is-missing");
      m.src = newSrc;
      fig.setAttribute("aria-label", newAlt);
      fig.querySelector(".liq-label").textContent = newAlt;
    }
  };
}

// Hero portrait — bare mode with looped video
mountLiquid(document.getElementById("heroFigure"), {

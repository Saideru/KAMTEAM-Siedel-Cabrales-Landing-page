/* ================================================================
   Line splitting for section headings
   ================================================================ */
function splitLines(el){
  const text = el.dataset.text || el.textContent.trim().replace(/\s+/g, " ");
  el.dataset.text = text;
  el.textContent = "";
  const words = text.split(" ");
  const spans = words.map((w, i) => {
    const s = document.createElement("span");
    s.textContent = w;
    el.appendChild(s);
    if (i < words.length - 1) el.appendChild(document.createTextNode(" "));
    return s;
  });
  const lines = [];
  let top = null;
  spans.forEach(s => {
    const t = s.offsetTop;
    if (top === null || Math.abs(t - top) > 2){ lines.push([]); top = t; }
    lines[lines.length - 1].push(s.textContent);
  });
  el.textContent = "";
  lines.forEach((ws, i) => {
    const line = document.createElement("span");
    line.className = "line";
    const inner = document.createElement("span");
    inner.className = "line-inner";
    inner.style.transitionDelay = (i * 90) + "ms";
    inner.textContent = ws.join(" ");
    line.appendChild(inner);
    el.appendChild(line);
  });
  el.classList.add("is-split");
  return lines.length;
}
function restoreText(el){
  el.textContent = el.dataset.text;
  el.classList.add("is-done");
}

/* ================================================================
   In-view observer (threshold 0, play once)
   ================================================================ */
const io = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    const el = entry.target;
    io.unobserve(el);
    el.classList.add("in-view");
    if (el.classList.contains("split") && !REDUCED){
      const n = el.querySelectorAll(".line").length;
      setTimeout(() => restoreText(el), 950 + n * 90 + 100);
    }
    if (el.id === "voiceFigWrap") playQuote();
  });
}, { threshold: 0 });

document.querySelectorAll("main .reveal").forEach(el => {
  if (!el.closest(".hero")) io.observe(el);
});
io.observe(document.getElementById("voiceFigWrap"));

const splitEls = [...document.querySelectorAll(".split")];
function setupSplits(){
  splitEls.forEach(el => {
    if (REDUCED){ el.classList.add("is-split", "is-done"); return; }
    splitLines(el);
    io.observe(el);
  });
}
// re-split headings that haven't played yet if the layout changes
let rsT;
addEventListener("resize", () => {
  clearTimeout(rsT);
  rsT = setTimeout(() => {
    if (REDUCED) return;
    splitEls.forEach(el => { if (!el.classList.contains("in-view")) splitLines(el); });
  }, 150);
});
(document.fonts ? document.fonts.ready : Promise.resolve()).then(setupSplits);

/* ================================================================
   Voices
   ================================================================ */
const VOICES = [
  { quote: "Marcus saw the market three years before the rest of us. Betting alongside him changed the trajectory of my entire career.",
    name: "Elena Cardoso", role: "Managing Partner, Meridian Ventures", img: `${ASSETS}/voices/voice-01.webp` },
  { quote: "He doesn't just write checks — he gets in the trenches at 6am and refuses to leave until the impossible part is solved.",
    name: "David Okonkwo", role: "Founder & CEO, Cadence Health", img: `${ASSETS}/voices/voice-02.webp` },
  { quote: "The most demanding mentor I've ever had, and the only reason our company survived its first winter. Relentless, generous, right.",
    name: "Priya Nandakumar", role: "CEO, Northwind Energy", img: `${ASSETS}/voices/voice-03.webp` }
];
// preload portraits so swaps are instant
VOICES.forEach(v => { const i = new Image(); i.src = v.img; });

const quoteEl = document.getElementById("voiceQuote");
const textEl = document.getElementById("voiceText");
const citeEl = document.getElementById("voiceCite");
const voiceImg = mountLiquid(document.getElementById("voiceFigure"), {
  src: VOICES[0].img, alt: VOICES[0].name, maxScale: 22
